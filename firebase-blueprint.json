{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication and contact details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["customer", "seller", "admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product item in catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 16 },
        "image": { "type": "string", "maxLength": 1024 },
        "description": { "type": "string", "maxLength": 4096 },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 128 },
        "sellerWhatsApp": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "price", "image", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "deliveryAddress": { "type": "string", "maxLength": 512 },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "notes": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["customerName", "customerPhone", "deliveryAddress", "totalPrice", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live real-time customer support or seller inquiry message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userAvatar": { "type": "string", "maxLength": 1024 },
        "text": { "type": "string", "maxLength": 2048 },
        "senderRole": { "type": "string", "enum": ["user", "seller", "support"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["text", "senderRole"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "icon": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "slug", "icon"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Merchant or store owner profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "shopName": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 256 },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "shopName", "phone", "whatsappNumber"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document indexed by UID"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory products catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store category list"
    },
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "description": "Seller store profile data"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders and WhatsApp transactions"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time user inquiries, live chat messages, and support logs"
    }
  }
}
